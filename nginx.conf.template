user www-data;
worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    keepalive_timeout 65;

    # WebSocket upgrade map
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate limiting for auth endpoints (brute-force protection)
    limit_req_zone $binary_remote_addr zone=auth:1m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:1m rate=30r/m;
    # Lease API: called server-to-server by pentestlab.cyberhx.com, so the
    # cap is per source IP and generous enough for polling a live exam.
    limit_req_zone $binary_remote_addr zone=lease:1m rate=120r/m;

    server {
        listen __PORT__;
        server_name _;

        # ── Security headers ──────────────────────────────────
        # frame-ancestors is templated from ALLOWED_FRAME_ANCESTORS so the
        # exam site can embed the terminal. X-Frame-Options is only emitted
        # when framing is same-origin-only: it has no multi-origin form, and
        # sending SAMEORIGIN alongside a wider CSP would block the embed.
        add_header X-Content-Type-Options "nosniff" always;
        __XFO_HEADER__
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ws: wss:; frame-ancestors __CSP_FRAME_ANCESTORS__; base-uri 'self'; form-action 'self'" always;

        # ── Landing page ─────────────────────────────────────
        root /var/www/landing;
        index index.html;

        location = / {
            try_files /index.html =404;
        }

        # ── Exam API ─────────────────────────────────────────
        # All exam-api proxied requests carry the internal token
        # so exam-api rejects direct access from lab users on localhost

        location = /api/exam/status {
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
            # Strip any client-supplied admin marker: only auth_basic routes set it.
            proxy_set_header X-CHX-Admin "";
        }

        location = /api/exam/start {
            limit_req zone=api burst=2 nodelay;
            __DEMO_AUTH__
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
            proxy_set_header X-CHX-Admin "__DEMO_ADMIN_FLAG__";
        }

        location = /api/exam/reset {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
            proxy_set_header X-CHX-Admin "1";
        }

        # ── Admin panel (password protected, rate-limited) ────
        location /admin {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            alias /var/www/landing;
            try_files /admin.html =404;
        }

        # Admin credentials API (proxied to exam-api, not static file)
        location = /api/admin/labs {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
            proxy_set_header X-CHX-Admin "1";
        }

        # ── Lease API (server-to-server, HMAC-authenticated) ──
        # Authorisation is the X-CHX-Signature HMAC verified by lab-api, not
        # the internal token: nginx attaches that token to every proxied
        # request, so it can never stand in for a caller's identity.
        location /api/v1/ {
            limit_req zone=lease burst=20 nodelay;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
            proxy_set_header X-CHX-Admin "";
            proxy_set_header Host $host;
            proxy_read_timeout 180s;
        }

        # ── Static assets ────────────────────────────────────
        location /assets/ {
            alias /var/www/landing/assets/;
            expires 1h;
        }

        # ── Lab wrapper (branded terminal page) ──────────────
        location ~ ^/lab/[0-9]+/?$ {
            root /var/www/landing;
            try_files /terminal.html =404;
        }

        # ── Terminal backend routes (auto-generated) ─────────
        # __LOCATIONS__

        # ── Health check ─────────────────────────────────────
        location = /health {
            return 200 '{"status":"ok"}';
            default_type application/json;
        }
    }
}
