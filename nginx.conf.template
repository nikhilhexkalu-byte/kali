worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    keepalive_timeout 65;

    # WebSocket upgrade map
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate limiting for auth endpoints (brute-force protection)
    limit_req_zone $binary_remote_addr zone=auth:1m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:1m rate=30r/m;

    server {
        listen __PORT__;
        server_name _;

        # ── Landing page ─────────────────────────────────────
        root /var/www/landing;
        index index.html;

        location = / {
            try_files /index.html =404;
        }

        # Public lab status API (no passwords)
        location = /api/labs {
            alias /var/www/landing/labs-public.json;
            default_type application/json;
            add_header Cache-Control "no-cache";
            add_header Access-Control-Allow-Origin "*";
        }

        # ── Admin panel (password protected, rate-limited) ────
        location /admin {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            alias /var/www/landing;
            try_files /admin.html =404;
        }

        # Admin credentials API (password protected, rate-limited)
        location = /api/admin/labs {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            alias /var/www/landing/labs-admin.json;
            default_type application/json;
            add_header Cache-Control "no-cache";
        }

        # ── Security headers ──────────────────────────────────
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;

        # ── Static assets ────────────────────────────────────
        location /assets/ {
            alias /var/www/landing/assets/;
            expires 1h;
        }

        # ── Lab terminal routes (auto-generated) ─────────────
        # __LOCATIONS__

        # ── Health check ─────────────────────────────────────
        location = /health {
            return 200 '{"status":"ok"}';
            default_type application/json;
        }
    }
}
