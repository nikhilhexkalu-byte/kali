worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 256;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    access_log    /dev/stdout;
    sendfile      on;
    keepalive_timeout 65;

    # WebSocket upgrade map
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate limiting for auth endpoints (brute-force protection)
    limit_req_zone $binary_remote_addr zone=auth:1m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:1m rate=30r/m;

    server {
        listen __PORT__;
        server_name _;

        # ── Security headers ──────────────────────────────────
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

        # ── Landing page ─────────────────────────────────────
        root /var/www/landing;
        index index.html;

        location = / {
            try_files /index.html =404;
        }

        # ── Exam API ─────────────────────────────────────────
        # All exam-api proxied requests carry the internal token
        # so exam-api rejects direct access from lab users on localhost

        location = /api/exam/status {
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
        }

        location = /api/exam/start {
            limit_req zone=api burst=2 nodelay;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
        }

        location = /api/exam/reset {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
        }

        # ── Admin panel (password protected, rate-limited) ────
        location /admin {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            alias /var/www/landing;
            try_files /admin.html =404;
        }

        # Admin credentials API (proxied to exam-api, not static file)
        location = /api/admin/labs {
            limit_req zone=auth burst=3 nodelay;
            auth_basic "CyberHX Admin";
            auth_basic_user_file /etc/nginx/.htpasswd_admin;
            proxy_pass http://127.0.0.1:9090;
            proxy_http_version 1.1;
            proxy_set_header X-Internal-Token "__INTERNAL_TOKEN__";
        }

        # ── Static assets ────────────────────────────────────
        location /assets/ {
            alias /var/www/landing/assets/;
            expires 1h;
        }

        # ── Lab terminal routes (auto-generated) ─────────────
        # __LOCATIONS__

        # ── Health check ─────────────────────────────────────
        location = /health {
            return 200 '{"status":"ok"}';
            default_type application/json;
        }
    }
}
